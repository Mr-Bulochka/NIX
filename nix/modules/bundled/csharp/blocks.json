{
  "blocks": {
    "function": {
      "start": "^(\\s*)(?:(?:public|protected|private|internal|static|async|sealed|override|virtual|abstract|partial|readonly|extern|new|unsafe)\\s+)*(?:[\\w<>\\[\\]]+\\s+)+(?P<name>[A-Za-z_][\\w$]*)\\s*\\(",
      "body": "braces"
    },
    "class": {
      "start": "^(\\s*)(?:(?:public|internal|abstract|sealed|static|partial)\\s+)*class\\s+(?P<name>[A-Za-z_][\\w$]*)",
      "body": "braces"
    },
    "if": {
      "start": "^(\\s*)if\\s*\\(",
      "body": "braces",
      "alternate": ["else if", "else"]
    },
    "for": {
      "start": "^(\\s*)for\\s*\\(",
      "body": "braces"
    },
    "while": {
      "start": "^(\\s*)while\\s*\\(",
      "body": "braces"
    },
    "try": {
      "start": "^(\\s*)try\\s*\\{",
      "body": "braces",
      "alternate": ["catch", "finally"]
    }
  }
}